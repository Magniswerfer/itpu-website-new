---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

const primaere = [
  { navn: 'Rød', token: '--el-red', hex: '#D0004D', rgb: '208-0-78', pantone: '7636C', fg: '#fff' },
  { navn: 'Grøn', token: '--el-green', hex: '#159F6B', rgb: '21-160-107', pantone: '2417C', fg: '#fff' },
];
const sekundaere = [
  { navn: 'Rosa', token: '--el-pink', hex: '#F9D1D9', rgb: '249-210-217', fg: '#1d1d1b' },
  { navn: 'Lysegrøn', token: '--el-green-light', hex: '#C8E2C2', rgb: '200-226-194', fg: '#1d1d1b' },
  { navn: 'Lyseblå', token: '--el-blue-light', hex: '#BCE3FA', rgb: '188-228-250', fg: '#1d1d1b' },
  { navn: 'Mørkegrøn', token: '--el-green-dark', hex: '#005247', rgb: '0-83-71', fg: '#fff' },
  { navn: 'Lysegul', token: '--el-yellow', hex: '#FFFAD2', rgb: '255-250-210', fg: '#1d1d1b' },
];
const flader = [
  { klasse: 'surface--red', navn: 'Rød', note: 'Hvid tekst, lyseblå accent' },
  { klasse: 'surface--green', navn: 'Grøn', note: 'Hvid tekst — kun store, fede tekster' },
  { klasse: 'surface--green-dark', navn: 'Mørkegrøn', note: 'Lysegrønne overskrifter' },
  { klasse: 'surface--green-light', navn: 'Lysegrøn', note: 'Røde overskrifter' },
  { klasse: 'surface--pink', navn: 'Rosa', note: 'Mørkegrønne overskrifter' },
  { klasse: 'surface--yellow', navn: 'Lysegul', note: 'Grønne overskrifter, rød accent' },
  { klasse: 'surface--blue-light', navn: 'Lyseblå', note: 'Røde overskrifter' },
];
---

<Base title="Designsystem" description="ITPU's designsystem, baseret på Enhedslistens designguide.">
  <header class="page-head surface--yellow">
    <div class="container stack" style="--stack: var(--space-5)">
      <span class="box">Designsystem</span>
      <h1 style="color: var(--el-red)">ITPU designsystem</h1>
      <p class="lead">
        Bygget på Enhedslistens Designguide 2.0 (2024): farver, skrift og logo følger guiden. Komponenterne er ITPU's
        egne. Tokens ligger i <code>src/styles/tokens.css</code>, komponenterne i <code>src/styles/global.css</code>.
      </p>
    </div>
  </header>

  <div class="container ds">
    <!-- Logo -->
    <section class="ds__section">
      <h2>Logo</h2>
      <p class="ds__intro">
        ITPU bruger Enhedslistens skabelon for lokalafdelinger: markør, navnetræk og en tredje kasse med udvalgets navn.
        Kassen er lige så høj som E'et i ENHEDSLISTEN, og afstanden mellem elementerne svarer til bredden af E'ets lodrette
        streg. Størrelsesforholdet mellem de tre elementer må ikke ændres.
      </p>
      <div class="ds__logos">
        <div class="ds__logo-box"><Logo size="3.5rem" href={null} /></div>
        <div class="ds__logo-box"><Logo size="2.5rem" marker={false} href={null} /></div>
        <div class="ds__logo-box ds__logo-box--row">
          <img src="/images/enhedslisten-markoer.svg" alt="Markør: Ø" width="96" height="96" />
          <img src="/images/enhedslisten-logo.svg" alt="Navnetræk: ENHEDSLISTEN" width="320" height="72" />
        </div>
      </div>
      <pre class="ds__code"><code>{`<Logo />                       // fuldt logo med markør
<Logo marker={false} />        // uden markør
<Logo size="3rem" />           // størrelse = højden på navnetrækket`}</code></pre>
    </section>

    <!-- Farver -->
    <section class="ds__section">
      <h2>Farver</h2>
      <p class="ds__intro">
        Enhedslistens primære farver er rød og grøn — én af dem skal altid være til stede. De primære farver bruges til
        overskrifter og effekter. De sekundære farver bruges til flader, kasser og baggrunde, og til tekst på rød eller grøn
        bund. Undgå rød og grøn direkte op ad hinanden.
      </p>
      <h3 class="ds__h3">Primære</h3>
      <div class="swatches swatches--big">
        {
          primaere.map((f) => (
            <div class="swatch" style={`background:${f.hex};color:${f.fg}`}>
              <strong>{f.navn}</strong>
              <span>HEX {f.hex}</span>
              <span>RGB {f.rgb}</span>
              <span>Pantone {f.pantone}</span>
              <code>var({f.token})</code>
            </div>
          ))
        }
      </div>
      <h3 class="ds__h3">Sekundære</h3>
      <div class="swatches">
        {
          sekundaere.map((f) => (
            <div class="swatch" style={`background:${f.hex};color:${f.fg}`}>
              <strong>{f.navn}</strong>
              <span>HEX {f.hex}</span>
              <span>RGB {f.rgb}</span>
              <code>var({f.token})</code>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Flader -->
    <section class="ds__section">
      <h2>Flader</h2>
      <p class="ds__intro">
        Farvekombinationerne fra designguiden er samlet i <code>.surface--*</code>-klasser, der sætter baggrund, tekst,
        overskrifter, links og accentfarve for alt indhold i fladen.
      </p>
      <div class="surfaces">
        {
          flader.map((f) => (
            <div class={`surface-demo ${f.klasse}`}>
              <span class="box">Kasse</span>
              <h3>{f.navn}</h3>
              <p>{f.note}</p>
              <code>.{f.klasse}</code>
            </div>
          ))
        }
      </div>
    </section>

    <!-- Typografi -->
    <section class="ds__section">
      <h2>Skrift</h2>
      <p class="ds__intro">
        Maj er Enhedslistens egen skrift og hele partiets stemme. Den findes i Light, Regular og Bold og har ingen kursiv —
        fremhæv med <strong>bold</strong>, STORE BOGSTAVER eller <span style="color: var(--el-red)">farve</span>.
      </p>
      <div class="type">
        <div class="type__row">
          <span class="type__label">Budskab · Maj Bold, versaler</span>
          <p class="budskab" style="font-size: var(--text-4xl); color: var(--el-red)">Offentlig kode</p>
        </div>
        <div class="type__row">
          <span class="type__label">H1 · Maj Bold, versaler</span>
          <p class="h1-demo">For offentlige penge</p>
        </div>
        <div class="type__row">
          <span class="type__label">H2 · Maj Bold, versaler</span>
          <h2 style="font-size: var(--text-3xl)">Privatliv frem for overvågning</h2>
        </div>
        <div class="type__row">
          <span class="type__label">H3 · Maj Bold</span>
          <h3>IT for mennesker, ikke mennesker for IT</h3>
        </div>
        <div class="type__row">
          <span class="type__label">Lead · Maj</span>
          <p class="lead">IT-politik er ikke bare teknik. Det er politik om magt, arbejde, frihed og demokrati.</p>
        </div>
        <div class="type__row">
          <span class="type__label">Brødtekst · Maj</span>
          <p style="max-width: 64ch">
            Offentlige IT-systemer skal bygges på åben software og åbne standarder, for at sikre uafhængighed og
            medbestemmelse. Åben software er software som alle kan læse, køre, ændre og distribuere.
          </p>
        </div>
        <div class="type__row">
          <span class="type__label">Citat</span>
          <blockquote class="quote" style="color: var(--el-red)">Mennesker skal ikke måles som tal og klik.</blockquote>
        </div>
      </div>
    </section>

    <!-- Komponenter -->
    <section class="ds__section">
      <h2>Komponenter</h2>

      <h3 class="ds__h3">Kasser</h3>
      <p class="ds__intro">Tekst i et farvet rektangel — samme greb som logoets navnekasse. Bruges som mærkat og overlinje.</p>
      <div class="row">
        <span class="box">Standard</span>
        <span class="box box--green">Grøn</span>
        <span class="box box--green-dark">Mørkegrøn</span>
        <span class="box box--ink">Sort</span>
        <span class="box box--lg">Stor kasse</span>
      </div>

      <h3 class="ds__h3">Knapper</h3>
      <div class="row">
        <a class="btn" href="#">Primær <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--green" href="#">Mørkegrøn</a>
        <a class="btn btn--outline" href="#">Kontur</a>
      </div>
      <div class="row surface--red" style="padding: var(--space-5); margin-top: var(--space-4)">
        <a class="btn btn--white" href="#">Hvid på rød</a>
        <a class="btn btn--outline" href="#">Kontur på rød</a>
      </div>

      <h3 class="ds__h3">Kort</h3>
      <div class="grid">
        <a class="card surface--white" href="#">
          <span class="box box--red" style="align-self: flex-start">Princip 1</span>
          <h4 class="card__title">Hvidt kort</h4>
          <p class="card__text">Standardkort med kant. Bruges til lister af principper og indhold.</p>
          <span class="card__more">Læs mere <span class="arrow" aria-hidden="true">→</span></span>
        </a>
        <a class="card surface--pink" href="#">
          <h4 class="card__title">Rosa kort</h4>
          <p class="card__text">Kort på en sekundær farve, til fremhævede henvisninger.</p>
          <span class="card__more">Læs mere <span class="arrow" aria-hidden="true">→</span></span>
        </a>
        <a class="card surface--red" href="#">
          <h4 class="card__title">Rødt kort</h4>
          <p class="card__text">Brug sparsomt — til det vigtigste budskab på siden.</p>
          <span class="card__more">Læs mere <span class="arrow" aria-hidden="true">→</span></span>
        </a>
      </div>

      <h3 class="ds__h3">Prosa</h3>
      <div class="prose">
        <p>Markdown fra CMS'et sættes med <code>.prose</code>. Links ser <a href="#">sådan her</a> ud.</p>
        <ul>
          <li>Punktopstillinger har røde punkter</li>
          <li>Fremhæv med <strong>bold</strong>, ikke kursiv</li>
        </ul>
        <blockquote>Citatblokke får en rosa flade.</blockquote>
      </div>
    </section>
  </div>
</Base>

<style>
  .page-head {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .ds {
    padding-block: var(--section-y);
  }
  .ds__section + .ds__section {
    margin-top: var(--space-9);
    padding-top: var(--space-8);
    border-top: var(--border) solid var(--el-ink);
  }
  .ds__section > h2 {
    margin-bottom: var(--space-5);
    font-size: var(--text-2xl);
  }
  .ds__intro {
    max-width: 64ch;
    margin-bottom: var(--space-6);
  }
  .ds__h3 {
    margin: var(--space-7) 0 var(--space-4);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ds__logos {
    display: grid;
    gap: var(--space-5);
  }
  .ds__logo-box {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-7);
    background: var(--el-white);
    box-shadow: inset 0 0 0 var(--border) var(--el-line);
    overflow-x: auto;
  }
  .ds__logo-box--row img:first-child {
    width: 72px;
    height: 72px;
  }
  .ds__logo-box--row img:last-child {
    width: auto;
    height: 72px;
  }
  .ds__code {
    margin: var(--space-5) 0 0;
    padding: var(--space-5);
    overflow-x: auto;
    background: var(--el-ink);
    color: var(--el-white);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
  .swatches {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
  }
  .swatches--big {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }
  .swatch {
    display: grid;
    gap: 0.15rem;
    align-content: end;
    min-height: 11rem;
    padding: var(--space-5);
    font-size: var(--text-sm);
  }
  .swatches--big .swatch {
    min-height: 15rem;
  }
  .swatch strong {
    font-size: var(--text-lg);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }
  .swatch code {
    margin-top: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .surfaces {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
  }
  .surface-demo {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    padding: var(--space-6);
  }
  .surface-demo h3 {
    font-size: var(--text-xl);
    text-transform: uppercase;
  }
  .surface-demo code {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .type {
    display: grid;
  }
  .type__row {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--el-line);
  }
  @media (min-width: 56rem) {
    .type__row {
      grid-template-columns: 14rem 1fr;
      align-items: baseline;
    }
  }
  .type__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
  .h1-demo {
    font-size: var(--text-4xl);
    font-weight: 700;
    text-transform: uppercase;
    line-height: 1;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }
</style>
