---
import Base from '../layouts/Base.astro';
import { getPrincipper, getNyheder, formatDato, principAnker } from '../lib/content';
import forside from '../data/forside.json';

const principper = await getPrincipper();
const nyheder = (await getNyheder()).slice(0, 3);
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text stack" style="--stack: var(--space-5)">
        <span class="box">{forside.heroMaerkat}</span>
        <h1 class="budskab hero__title">{forside.heroOverskrift}</h1>
        <p class="lead">{forside.heroTekst}</p>
        <div class="btn-row">
          <a class="btn" href="/principprogram/">{forside.heroKnap} <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--outline" href="/om/">Om udvalget</a>
        </div>
      </div>
      <nav class="hero__panel surface--red" aria-labelledby="hero-principper">
        <h2 id="hero-principper" class="hero__panel-title">Fem principper</h2>
        <ol class="hero__list">
          {
            principper.map((p) => (
              <li>
                <a href={`/principprogram/#${principAnker(p.id)}`}>
                  <span class="hero__num">{pad(p.data.order)}</span>
                  <span>{p.data.title}</span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>
  </section>

  <!-- Citat -->
  <section class="section surface--green-light">
    <div class="container">
      <blockquote class="quote quote--big">{forside.citat}</blockquote>
      <p class="quote-source">Fra forslag til IT-principprogram</p>
    </div>
  </section>

  <!-- Principper -->
  <section class="section">
    <div class="container">
      <header class="section__head">
        <span class="box">Principprogram</span>
        <h2>{forside.principperOverskrift}</h2>
        <p class="lead">{forside.principperTekst}</p>
      </header>
      <div class="grid">
        {
          principper.map((p) => (
            <a class="card surface--white" href={`/principprogram/#${principAnker(p.id)}`}>
              <span class="box box--red card__num">Princip {p.data.order}</span>
              <h3 class="card__title">{p.data.title}</h3>
              <p class="card__text">{p.data.kort}</p>
              <span class="card__more">
                Læs mere <span class="arrow" aria-hidden="true">→</span>
              </span>
            </a>
          ))
        }
        <a class="card surface--pink card--cta" href="/principprogram/">
          <h3 class="card__title">Læs hele forslaget</h3>
          <p class="card__text">Indledning, de fem principper og status på behandlingen i Hovedbestyrelsen.</p>
          <span class="card__more">
            Til principprogrammet <span class="arrow" aria-hidden="true">→</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Nyheder -->
  {
    nyheder.length > 0 && (
      <section class="section surface--yellow">
        <div class="container">
          <header class="section__head section__head--row">
            <h2>Nyheder</h2>
            <a class="btn btn--outline" href="/nyheder/">
              Alle nyheder <span class="arrow" aria-hidden="true">→</span>
            </a>
          </header>
          <ul class="news">
            {nyheder.map((n) => (
              <li>
                <a class="news__item" href={`/nyheder/${n.id}/`}>
                  <time class="meta" datetime={n.data.date.toISOString()}>
                    {formatDato(n.data.date)}
                  </time>
                  <h3 class="news__title">{n.data.title}</h3>
                  <p>{n.data.resume}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Vær med -->
  <section class="section surface--green">
    <div class="container cta">
      <h2 class="budskab cta__title">{forside.meldDigOverskrift}</h2>
      <div class="stack" style="--stack: var(--space-5)">
        <p class="lead">{forside.meldDigTekst}</p>
        <div class="btn-row">
          <a class="btn btn--green" href="/om/#vaer-med">Sådan bliver du aktiv <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1rem + 5vw, 6rem);
  }
  .hero__grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }
  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: 1.35fr 1fr;
      gap: var(--space-8);
    }
  }
  .hero__title {
    font-size: clamp(3rem, 1.6rem + 6vw, 7rem);
    color: var(--el-red);
  }
  .hero__panel {
    padding: var(--space-6);
  }
  @media (min-width: 64rem) {
    .hero__panel {
      padding: var(--space-7);
    }
  }
  .hero__panel-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-5);
  }
  .hero__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hero__list li + li {
    border-top: 1px solid rgb(255 255 255 / 0.35);
  }
  .hero__list a {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-4);
    font-weight: var(--weight-bold);
    font-size: var(--text-lg);
    line-height: 1.2;
    text-decoration: none;
  }
  .hero__list a:hover span:last-child {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .hero__num {
    color: var(--el-blue-light);
  }

  .quote--big {
    max-width: 30ch;
    font-size: var(--text-3xl);
    color: var(--el-red);
    line-height: 1.1;
  }
  .quote-source {
    margin-top: var(--space-5);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    font-size: var(--text-sm);
    letter-spacing: 0.03em;
  }

  .card__num {
    align-self: flex-start;
  }
  .card--cta {
    justify-content: flex-end;
  }

  .section__head--row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    max-width: none;
  }
  .news {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 56rem) {
    .news {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .news__item {
    display: grid;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-6);
    background: var(--el-white);
    color: var(--el-ink);
    text-decoration: none;
    border-top: 6px solid var(--el-red);
    transition: transform var(--duration-base) var(--ease-out);
  }
  .news__item:hover {
    color: var(--el-ink);
    transform: translateY(-4px);
  }
  .news__title {
    font-size: var(--text-xl);
    line-height: 1.15;
  }

  .cta {
    display: grid;
    gap: var(--space-6);
    align-items: end;
  }
  @media (min-width: 56rem) {
    .cta {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-8);
    }
  }
  .cta__title {
    font-size: clamp(2.5rem, 1.5rem + 4.5vw, 5.5rem);
  }
</style>
