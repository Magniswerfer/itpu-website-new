---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getPrincipper, principAnker } from '../lib/content';

const side = await getEntry('sider', 'principprogram');
if (!side) throw new Error('Mangler src/content/sider/principprogram.md');
const { Content: Indledning } = await render(side);
const principper = await Promise.all(
  (await getPrincipper()).map(async (p) => ({ ...p, Content: (await render(p)).Content })),
);
---

<Base title={side.data.title} description={side.data.undertitel}>
  <header class="page-head surface--red">
    <div class="container stack" style="--stack: var(--space-5)">
      <span class="box">IT-Politisk Udvalg</span>
      <h1>{side.data.title}</h1>
      {side.data.undertitel && <p class="lead">{side.data.undertitel}</p>}
      {side.data.status && <p class="status"><strong>Status:</strong> {side.data.status}</p>}
    </div>
  </header>

  <div class="container program">
    <aside class="toc" aria-labelledby="toc-title">
      <div class="toc__inner">
        <h2 id="toc-title" class="toc__title">Indhold</h2>
        <ol>
          <li><a href="#indledning">Indledning</a></li>
          {
            principper.map((p) => (
              <li>
                <a href={`#${principAnker(p.id)}`}>{p.data.title}</a>
              </li>
            ))
          }
        </ol>
      </div>
    </aside>

    <div class="program__body">
      <section id="indledning" class="program__section">
        <h2 class="program__h">Indledning</h2>
        <div class="prose"><Indledning /></div>
      </section>

      {
        principper.map((p) => (
          <section id={principAnker(p.id)} class="program__section">
            <span class="box box--red">Princip {p.data.order}</span>
            <h2 class="program__h">{p.data.title}</h2>
            {p.data.citat && <blockquote class="quote program__quote">{p.data.citat}</blockquote>}
            <div class="prose">
              <p.Content />
            </div>
          </section>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .page-head {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
  }
  .page-head h1 {
    max-width: 18ch;
  }
  .status {
    max-width: 60ch;
    padding: var(--space-4) var(--space-5);
    background: var(--el-blue-light);
    color: var(--el-ink);
  }
  .program {
    display: grid;
    gap: var(--space-7);
    padding-block: var(--section-y);
  }
  @media (min-width: 64rem) {
    .program {
      grid-template-columns: 17rem 1fr;
      gap: var(--space-9);
    }
  }
  .toc__inner {
    position: sticky;
    top: 7.5rem;
    padding: var(--space-5);
    background: var(--el-pink);
  }
  .toc__title {
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    margin-bottom: var(--space-3);
  }
  .toc ol {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding-left: 1.2em;
    font-size: var(--text-sm);
    line-height: 1.3;
  }
  .toc li::marker {
    color: var(--el-red);
    font-weight: 700;
  }
  .toc a {
    color: var(--el-ink);
    text-decoration: none;
    font-weight: 700;
  }
  .toc a:hover {
    color: var(--el-red);
    text-decoration: underline;
  }
  .program__section + .program__section {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: var(--border) solid var(--el-line);
  }
  .program__h {
    margin: var(--space-4) 0 var(--space-6);
    font-size: var(--text-2xl);
    max-width: 22ch;
  }
  .program__quote {
    max-width: 34ch;
    margin-bottom: var(--space-6);
    font-size: var(--text-xl);
    color: var(--el-red);
  }
</style>
