---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { settings } from '../data/site';

interface Props {
  title?: string | undefined;
  description?: string | undefined;
}

const { title, description = settings.beskrivelse } = Astro.props;
const fullTitle = title ? `${title} · ${settings.sitenavn}` : `${settings.sitenavn} – ${settings.fuldtNavn}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Maj-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Maj-Bold.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#d0004d" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${settings.sitenavn} – nyheder`} href="/rss.xml" />
  </head>
  <body>
    <a class="skip-link" href="#indhold">
      Gå til indhold
    </a>
    <Header />
    <main id="indhold">
      <slot />
    </main>
    <Footer />
  </body>
</html>
