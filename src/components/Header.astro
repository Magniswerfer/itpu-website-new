---
import Logo from './Logo.astro';

const nav = [
  { href: '/principprogram/', label: 'Principprogram' },
  { href: '/nyheder/', label: 'Nyheder' },
  { href: '/om/', label: 'Om udvalget' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <Logo />
    <nav aria-label="Hovedmenu">
      <details class="menu">
        <summary class="menu__toggle">
          <span class="menu__icon" aria-hidden="true"></span>
          <span>Menu</span>
        </summary>
        <ul class="menu__list">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
          <li><a class="btn menu__cta" href="/om/#vaer-med">Vær med</a></li>
        </ul>
      </details>
    </nav>
  </div>
</header>

<script>
  // Menuen er altid åben på store skærme; på mobil fungerer den som en fold-ud.
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  const mq = window.matchMedia('(min-width: 56rem)');
  const sync = () => menu && (menu.open = mq.matches);
  sync();
  mq.addEventListener('change', sync);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--el-white);
    border-bottom: 1px solid var(--el-line);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 5.25rem;
    padding-block: var(--space-3);
  }
  .menu__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 1.1rem;
    background: var(--el-pink);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    font-size: var(--text-sm);
    cursor: pointer;
    list-style: none;
  }
  .menu__toggle::-webkit-details-marker {
    display: none;
  }
  .menu__icon,
  .menu__icon::before,
  .menu__icon::after {
    display: block;
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform var(--duration-base) var(--ease-out);
  }
  .menu__icon {
    position: relative;
  }
  .menu__icon::before,
  .menu__icon::after {
    content: '';
    position: absolute;
  }
  .menu__icon::before {
    top: -6px;
  }
  .menu__icon::after {
    top: 6px;
  }
  .menu[open] .menu__icon {
    background: transparent;
  }
  .menu[open] .menu__icon::before {
    transform: translateY(6px) rotate(45deg);
  }
  .menu[open] .menu__icon::after {
    transform: translateY(-6px) rotate(-45deg);
  }
  .menu__list {
    position: absolute;
    inset: 100% 0 auto 0;
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-4) var(--gutter) var(--space-6);
    list-style: none;
    background: var(--el-white);
    border-bottom: 1px solid var(--el-line);
  }
  .menu__list a:not(.btn) {
    display: block;
    padding: 0.7rem 0;
    color: var(--el-ink);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }
  .menu__list a[aria-current='page'] {
    color: var(--el-red);
  }
  .menu__cta {
    margin-top: var(--space-3);
  }

  @media (min-width: 56rem) {
    .menu__toggle {
      display: none;
    }
    .menu__list {
      position: static;
      display: flex;
      align-items: center;
      gap: var(--space-5);
      padding: 0;
      border: 0;
      background: none;
    }
    .menu__list a:not(.btn) {
      position: relative;
      padding: 0.4rem 0;
      font-size: var(--text-sm);
      text-transform: uppercase;
      letter-spacing: 0.02em;
    }
    .menu__list a:not(.btn)::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 3px;
      background: var(--el-red);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--duration-base) var(--ease-out);
    }
    .menu__list a:not(.btn):hover::after,
    .menu__list a[aria-current='page']::after {
      transform: scaleX(1);
    }
    .menu__list a:not(.btn):hover {
      color: var(--el-ink);
    }
    .menu__cta {
      margin: 0 0 0 var(--space-2);
      min-height: 2.75rem;
      padding: 0.7em 1.4em;
    }
  }
</style>
